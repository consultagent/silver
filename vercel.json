{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "BREVO_API_KEY": "@brevo_api_key",
    "NODE_ENV": "production"
  },
  "functions": {
    "api/preorder.js": {
      "maxDuration": 10,
      "memory": 128
    }
  }
}
