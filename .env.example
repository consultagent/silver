# Brevo API Key (required for preorder endpoint)
# Get key from: https://app.brevo.com/settings/account/api
# Store in Vercel: https://vercel.com/[team]/silver/settings/environment-variables
BREVO_API_KEY=xkeysib-YOUR_KEY_HERE

# Resend API Key (required for /api/send-catalogue)
# Get key from: https://resend.com/api-keys
# The sending domain (expostores.com) must be verified in Resend first.
RESEND_API_KEY=re_YOUR_KEY_HERE

# Supabase service-role key (required for /api/catalogue and /api/send-catalogue)
# Get it from: Supabase project settings > API > service_role key
# Used server-side only, never exposed to the browser, since it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Environment
NODE_ENV=production
